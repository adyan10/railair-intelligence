# ==============================================================================
# RailAir Intelligence Backend Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME="RailAir Intelligence Backend"

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# PostgreSQL + PostGIS Connection Settings (Optional for Phase 1 MVP)
# Format: postgresql+psycopg://username:password@localhost:5432/railair_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railair_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
